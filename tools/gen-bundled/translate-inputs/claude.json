{
  "plain": { "model": "m1", "max_tokens": 256, "stream": true, "messages": [{ "role": "user", "content": "hi" }] },
  "system": {
    "model": "m1", "max_tokens": 256, "stream": true, "temperature": 0.2,
    "system": [{ "type": "text", "text": "be brief" }],
    "messages": [{ "role": "user", "content": "hi" }]
  },
  "multi_turn": {
    "model": "m1", "max_tokens": 256, "stream": true, "system": "be brief",
    "messages": [
      { "role": "user", "content": "hi" },
      { "role": "assistant", "content": [{ "type": "text", "text": "hello" }] },
      { "role": "user", "content": [{ "type": "text", "text": "how are you?" }] }
    ]
  },
  "tools": {
    "model": "m1", "max_tokens": 256, "stream": true,
    "messages": [
      { "role": "user", "content": "weather in Oslo?" },
      { "role": "assistant", "content": [{ "type": "text", "text": "checking" }, { "type": "tool_use", "id": "toolu_1", "name": "get_weather", "input": { "city": "Oslo" } }] },
      { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "toolu_1", "content": "rain", "is_error": true }, { "type": "text", "text": "thanks" }] }
    ],
    "tools": [{ "name": "get_weather", "description": "d", "input_schema": { "type": "object", "properties": { "city": { "type": "string" } }, "required": ["city"] } }],
    "tool_choice": { "type": "auto" }
  },
  "images": {
    "model": "m1", "max_tokens": 256, "stream": true,
    "messages": [{ "role": "user", "content": [
      { "type": "text", "text": "what is this?" },
      { "type": "image", "source": { "type": "base64", "media_type": "image/png", "data": "AAA" } },
      { "type": "image", "source": { "type": "url", "url": "https://example.com/cat.png" } }
    ] }]
  },
  "thinking": {
    "model": "m1", "max_tokens": 4096, "stream": true, "thinking": { "type": "enabled", "budget_tokens": 2048 },
    "messages": [
      { "role": "user", "content": "2+2?" },
      { "role": "assistant", "content": [{ "type": "thinking", "thinking": "adding", "signature": "sig-1" }, { "type": "text", "text": "4" }] },
      { "role": "user", "content": "and 3+3?" }
    ]
  },
  "cache_control": {
    "model": "m1", "max_tokens": 256, "stream": true,
    "system": [{ "type": "text", "text": "be brief", "cache_control": { "type": "ephemeral" } }],
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "hi", "cache_control": { "type": "ephemeral" } }] }]
  }
}
