(module
  (import "nr" "log" (func $log (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 40000) "sk-")
  (data (i32.const 40016) "Bearer")
  (data (i32.const 40032) "NR-SENTINEL-")
  (data (i32.const 40064) "\7b\22edits\22:\5b\7b\22op\22:\22replace\22,\22path\22:\22user\22,\22kind\22:\22converted\22,\22reason\22:\22format_conversion\22,\22value\22:\22")
  (data (i32.const 40320) "\22\7d\5d\7d")
  (func (export "zr_alloc") (param i32) (result i32) i32.const 4096)
  
  (func $copy (param $dst i32) (param $src i32) (param $n i32)
    (local $i i32)
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (i32.store8 (i32.add (local.get $dst) (local.get $i)) (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l))))
  (func $eq (param $a i32) (param $b i32) (param $n i32) (result i32)
    (local $i i32)
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i))) (i32.load8_u (i32.add (local.get $b) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (i32.const 1))
  (func $at (param $ptr i32) (param $len i32) (param $i i32) (param $pat i32) (param $plen i32) (result i32)
    (if (result i32) (i32.gt_u (i32.add (local.get $i) (local.get $plen)) (local.get $len))
      (then (i32.const 0))
      (else (call $eq (i32.add (local.get $ptr) (local.get $i)) (local.get $pat) (local.get $plen)))))
  (func $find (param $ptr i32) (param $len i32) (result i32)
    (local $i i32)
    (block $out
      (loop $l
        (br_if $out (i32.ge_u (local.get $i) (local.get $len)))
        (if (call $at (local.get $ptr) (local.get $len) (local.get $i) (i32.const 40000) (i32.const 3))
          (then (return (i32.add (local.get $i) (i32.const 1)))))
        (if (call $at (local.get $ptr) (local.get $len) (local.get $i) (i32.const 40016) (i32.const 6))
          (then (return (i32.add (local.get $i) (i32.const 1)))))
        (if (call $at (local.get $ptr) (local.get $len) (local.get $i) (i32.const 40032) (i32.const 12))
          (then (return (i32.add (local.get $i) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (i32.const 0))

  (func (export "zr_on_request") (param i32 i32) (result i64) (local $h i32) (local $n i32) (local $o i32) (local $c i32) (local $b i32)
    (local.set $h (call $find (local.get 0) (local.get 1)))
    (if (i32.eqz (local.get $h)) (then (return (i64.const 0))))
    (local.set $h (i32.sub (local.get $h) (i32.const 1)))
    (local.set $n (i32.sub (local.get 1) (local.get $h)))
    (if (i32.gt_u (local.get $n) (i32.const 32)) (then (local.set $n (i32.const 32))))
    (call $log (i32.add (local.get 0) (local.get $h)) (local.get $n))
    (call $copy (i32.const 32768) (i32.const 40064) (i32.const 97))
    (local.set $o (i32.add (i32.const 32768) (i32.const 97)))
    (block $stop
      (loop $l
        (br_if $stop (i32.ge_u (local.get $c) (local.get $n)))
        (local.set $b (i32.load8_u (i32.add (i32.add (local.get 0) (local.get $h)) (local.get $c))))
        (br_if $stop (i32.or (i32.or (i32.lt_u (local.get $b) (i32.const 32)) (i32.gt_u (local.get $b) (i32.const 126)))
                             (i32.or (i32.eq (local.get $b) (i32.const 34)) (i32.eq (local.get $b) (i32.const 92)))))
        (i32.store8 (i32.add (local.get $o) (local.get $c)) (local.get $b))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $l)))
    (call $copy (i32.add (local.get $o) (local.get $c)) (i32.const 40320) (i32.const 4))
    (i64.or (i64.shl (i64.const 32768) (i64.const 32))
            (i64.extend_i32_u (i32.add (i32.add (i32.const 97) (local.get $c)) (i32.const 4)))))
  (@custom "nr.abi" "\01\00\00\00"))
